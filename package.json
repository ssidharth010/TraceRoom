{
  "name": "traceroom",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,ui --prefix-colors cyan,magenta \"npm run api:dev\" \"node scripts/wait-for-api.mjs && npm --prefix frontend run dev\"",
    "run:once": "tsx src/index.ts",
    "api": "tsx src/api/server.ts",
    "api:dev": "tsx watch --clear-screen=false src/api/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/session/testSession.ts && tsx src/market/testSnapshot.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "0.208.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-logs-otlp-http": "0.208.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/instrumentation-pino": "0.55.1",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.4.2",
    "openai": "^6.47.0",
    "pino": "10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
