# Required: OpenAI-compatible debate model
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Required: telemetry labels and cost accounting
LLM_PROVIDER=openai
LLM_INPUT_COST_PER_1M_USD=0
LLM_CACHED_INPUT_COST_PER_1M_USD=0
LLM_OUTPUT_COST_PER_1M_USD=0
LLM_PRICING_VERSION=local

# Optional: Snapshot Forge numeric authority for non-INFY symbols
TWELVE_DATA_API_KEY=
SNAPSHOT_MAX_AGE_HOURS=72

# Optional: Snapshot Forge context research
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5.4-nano

# Optional: session cost threshold recorded in telemetry
SESSION_COST_ALERT_THRESHOLD_USD=0.10

# Optional: local service and persistence overrides
PORT=8787
TRACEROOM_DB_PATH=data/traceroom.sqlite

# Optional: SigNoz and read-only MCP auditor
SIGNOZ_BASE_URL=http://localhost:8080
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_MCP_TIMEOUT_MS=2500
# Required only when credentials are not configured on the MCP server:
# SIGNOZ_API_KEY=your-signoz-api-key
