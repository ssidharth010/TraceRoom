# Required: debate model
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# Optional: set real provider prices to enable cost estimates.
LLM_INPUT_COST_PER_1M_USD=0
LLM_CACHED_INPUT_COST_PER_1M_USD=0
LLM_OUTPUT_COST_PER_1M_USD=0
LLM_PRICING_VERSION=2026-07-21

# Required: local TraceRoom runtime
PORT=8787
TRACEROOM_DB_PATH=data/traceroom.sqlite

# Required: local SigNoz judge path
SIGNOZ_BASE_URL=http://localhost:8080
SIGNOZ_INSTANCE_URL=http://localhost:8080
SIGNOZ_MCP_URL=http://localhost:8000/mcp
SIGNOZ_MCP_TIMEOUT_MS=10000
SIGNOZ_MCP_PROTOCOL_VERSION=2025-06-18
SIGNOZ_API_KEY=your-signoz-api-key

# Replace these placeholders with the webUrl values printed by:
# npm run signoz:bootstrap
SIGNOZ_DASHBOARD_URL=http://localhost:8080/dashboard/your-dashboard-id
SIGNOZ_ALERT_URLS=http://localhost:8080/alerts/overview?ruleId=first,http://localhost:8080/alerts/overview?ruleId=second,http://localhost:8080/alerts/overview?ruleId=third

# Alert thresholds and the local webhook receiver created by the bootstrap.
SIGNOZ_BOOTSTRAP_WEBHOOK_URL=http://host.docker.internal:8787/signoz/alerts/webhook
SESSION_COST_ALERT_THRESHOLD_USD=0.10
TRACEROOM_DEMO_COST_ALERT_USD=0.05

# Optional: experimental custom snapshots. Not used by Judge Mode.
TWELVE_DATA_API_KEY=your-twelve-data-api-key
SNAPSHOT_MAX_AGE_HOURS=72
OPENAI_API_KEY=your-openai-api-key
OPENAI_SEARCH_MODEL=gpt-5.4-nano
